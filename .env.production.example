# VeraPolitica production template.
# Copy to `.env.production` (gitignored) and fill in real values.
# Never commit the filled file. See docs/production_deployment.md,
# docs/production_configuration.md, and docs/production_containers.md.
#
# Local development uses `.env.example` instead.
# Scheduler cron values must stay blank until a later deployment step.
# Leaving LLM provider blank keeps AI extraction disabled; it does not
# start a background AI job.
#
# Local production-like Docker Compose (development-only values):
#   VERAPOLITICA_PUBLIC_BASE_URL=http://127.0.0.1:8000
#   VERAPOLITICA_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
#   VERAPOLITICA_TRUSTED_HOSTS=localhost,127.0.0.1,web,testserver
#   VERAPOLITICA_ADMIN_API_KEY=<24+ random characters, not a demo/test key>
# Compose always connects to service `db`; POSTGRES_* below must match.

# Application
VERAPOLITICA_ENV=production
VERAPOLITICA_PUBLIC_BASE_URL=https://example.com
VERAPOLITICA_LOG_LEVEL=INFO
VERAPOLITICA_LOG_FORMAT=json
VERAPOLITICA_WEB_HOST=0.0.0.0
VERAPOLITICA_WEB_PORT=8000
VERAPOLITICA_WEB_WORKERS=2
VERAPOLITICA_ENABLE_DEMO_UI=false
VERAPOLITICA_ENABLE_API_DOCS=false

# Database
# Production requires PostgreSQL. Do not use SQLite.
# Compose stack overrides HOST with the `db` service name.
VERAPOLITICA_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/verapolitica
VERAPOLITICA_DB_POOL_SIZE=5
VERAPOLITICA_DB_MAX_OVERFLOW=5
VERAPOLITICA_DB_POOL_TIMEOUT=30
VERAPOLITICA_DB_POOL_RECYCLE=1800

# Compose PostgreSQL (local production-like stack only; not read by Settings).
# Development-only defaults. Do not reuse on a public VPS.
POSTGRES_USER=verapolitica
POSTGRES_PASSWORD=verapolitica
POSTGRES_DB=verapolitica

# Security / admin
# Generate a long random secret (24+ characters). Do not reuse demo/test keys.
VERAPOLITICA_ADMIN_API_KEY=
VERAPOLITICA_ADMIN_REVIEWER_IDENTITY=production-editor
# Comma-separated allowlists. Must include PUBLIC_BASE_URL origin/host. No "*".
VERAPOLITICA_CORS_ORIGINS=https://example.com
VERAPOLITICA_TRUSTED_HOSTS=example.com
# Set only to trusted reverse-proxy IPs or CIDRs. Leave empty to ignore X-Forwarded-*.
VERAPOLITICA_FORWARDED_ALLOW_IPS=

# Storage
# Absolute path on a persistent volume. Do not use ./data/raw or demo trees.
VERAPOLITICA_RAW_STORAGE_PATH=/var/lib/verapolitica/raw
# Optional public portraits map. Leave blank if unused.
VERAPOLITICA_PORTRAITS_PATH=

# AI / Ollama
# Blank provider disables live extraction. Operator commands only; no auto-start.
VERAPOLITICA_LLM_PROVIDER=
VERAPOLITICA_LLM_MODEL=
VERAPOLITICA_LLM_API_KEY=
VERAPOLITICA_OLLAMA_BASE_URL=http://127.0.0.1:11434
VERAPOLITICA_OLLAMA_NUM_CTX=8192
VERAPOLITICA_OLLAMA_STRUCTURED_FORMAT=json
VERAPOLITICA_LLM_TIMEOUT_SECONDS=180
VERAPOLITICA_LLM_MAX_RETRIES=1

# Scheduler
# Blank cron values disable the job. Five-field UTC cron. Keep blank for now.
VERAPOLITICA_SCHEDULE_SENATO_CRON=
VERAPOLITICA_SCHEDULE_CAMERA_CRON=
VERAPOLITICA_SCHEDULE_GOVERNO_CRON=
VERAPOLITICA_SCHEDULE_PROPOSALS_CRON=
VERAPOLITICA_SCHEDULE_TERRITORIES_CRON=
VERAPOLITICA_SCHEDULE_TERRITORIAL_OFFICES_CRON=
VERAPOLITICA_SCHEDULE_CIVIC_REMINDERS_CRON=
VERAPOLITICA_SCHEDULE_PLEDGE_EVIDENCE_CRON=
VERAPOLITICA_JOB_MAX_RETRIES=1
VERAPOLITICA_JOB_RETRY_BACKOFF_SECONDS=2
VERAPOLITICA_JOB_STALE_AFTER_MINUTES=60
