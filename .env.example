VERAPOLITICA_DATABASE_URL=sqlite:///./data/verapolitica.db
VERAPOLITICA_RAW_STORAGE_PATH=./data/raw
VERAPOLITICA_SENATO_SPARQL_ENDPOINT=https://dati.senato.it/sparql
VERAPOLITICA_SENATO_LEGISLATURE=19
VERAPOLITICA_SENATO_REQUEST_TIMEOUT_SECONDS=30
VERAPOLITICA_CAMERA_SPARQL_ENDPOINT=https://dati.camera.it/sparql
VERAPOLITICA_CAMERA_LEGISLATURE=19
VERAPOLITICA_CAMERA_REQUEST_TIMEOUT_SECONDS=30
VERAPOLITICA_GOVERNO_INDEX_URL=https://www.governo.it/it/ministri-e-sottosegretari
VERAPOLITICA_GOVERNO_REQUEST_TIMEOUT_SECONDS=30

# Required to access /admin/* routes.
# Set a long random secret locally. Never commit the real secret.
VERAPOLITICA_ADMIN_API_KEY=

# Identity recorded for review actions performed through the Admin API.
VERAPOLITICA_ADMIN_REVIEWER_IDENTITY=local-editor
