# APP
VERAPOLITICA_ENV=development
VERAPOLITICA_PUBLIC_BASE_URL=
VERAPOLITICA_WEB_HOST=127.0.0.1
VERAPOLITICA_WEB_PORT=8000
VERAPOLITICA_WEB_WORKERS=2
VERAPOLITICA_ENABLE_DEMO_UI=
VERAPOLITICA_ENABLE_API_DOCS=

# DATABASE
# SQLite is the local/test default. Production requires PostgreSQL.
VERAPOLITICA_DATABASE_URL=sqlite:///./data/verapolitica.db
# VERAPOLITICA_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/verapolitica
VERAPOLITICA_DB_POOL_SIZE=5
VERAPOLITICA_DB_MAX_OVERFLOW=5
VERAPOLITICA_DB_POOL_TIMEOUT=30
VERAPOLITICA_DB_POOL_RECYCLE=1800

# ADMIN
# Required to access /admin/* routes. Use a long random secret locally.
# Never commit the real secret. Production rejects short or well-known keys.
VERAPOLITICA_ADMIN_API_KEY=
VERAPOLITICA_ADMIN_REVIEWER_IDENTITY=local-editor

# CORS / PROXY
# Comma-separated allowlists. Production must not use "*".
VERAPOLITICA_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
VERAPOLITICA_TRUSTED_HOSTS=localhost,127.0.0.1,testserver
# Leave empty unless a reverse proxy is trusted to set X-Forwarded-* headers.
VERAPOLITICA_FORWARDED_ALLOW_IPS=

# AI
# Optional AI extraction. Blank values disable live provider calls.
# Production never enables paid calls unless provider, model, and key are all set.
VERAPOLITICA_LLM_PROVIDER=
VERAPOLITICA_LLM_MODEL=
VERAPOLITICA_LLM_API_KEY=
VERAPOLITICA_LLM_TIMEOUT_SECONDS=60
VERAPOLITICA_LLM_MAX_RETRIES=1
VERAPOLITICA_AI_MAX_DOCUMENT_BYTES=10000000
VERAPOLITICA_AI_MAX_CHUNK_CHARS=4000
VERAPOLITICA_AI_MAX_DOCUMENT_CHUNKS=200
VERAPOLITICA_AI_MAX_CHUNKS_PER_RUN=40
VERAPOLITICA_AI_MAX_EVIDENCE_EXCERPT_CHARS=600
VERAPOLITICA_AI_EVAL_MIN_PRECISION=0.90
VERAPOLITICA_AI_EVAL_MIN_EVIDENCE_ACCURACY=0.95
VERAPOLITICA_AI_EVAL_MAX_HALLUCINATION_RATE=0.05

# SCHEDULER
# Blank cron values disable the job. Five-field UTC cron.
VERAPOLITICA_SCHEDULE_SENATO_CRON=
VERAPOLITICA_SCHEDULE_CAMERA_CRON=
VERAPOLITICA_SCHEDULE_GOVERNO_CRON=
VERAPOLITICA_SCHEDULE_PROPOSALS_CRON=
VERAPOLITICA_SCHEDULE_TERRITORIES_CRON=
VERAPOLITICA_SCHEDULE_TERRITORIAL_OFFICES_CRON=
VERAPOLITICA_SCHEDULE_CIVIC_REMINDERS_CRON=
VERAPOLITICA_JOB_MAX_RETRIES=1
VERAPOLITICA_JOB_RETRY_BACKOFF_SECONDS=2
VERAPOLITICA_JOB_STALE_AFTER_MINUTES=60

# LOGGING
# text for local development; json is the production default when env=production.
VERAPOLITICA_LOG_FORMAT=text
VERAPOLITICA_LOG_LEVEL=INFO

# STORAGE
# Production must mount this as a persistent volume. Do not use an ephemeral container disk.
VERAPOLITICA_RAW_STORAGE_PATH=./data/raw

# SOURCE ENDPOINTS
VERAPOLITICA_SENATO_SPARQL_ENDPOINT=https://dati.senato.it/sparql
VERAPOLITICA_SENATO_LEGISLATURE=19
VERAPOLITICA_SENATO_REQUEST_TIMEOUT_SECONDS=30
VERAPOLITICA_SENATO_PROPOSAL_RECORD_LIMIT=100
VERAPOLITICA_CAMERA_SPARQL_ENDPOINT=https://dati.camera.it/sparql
VERAPOLITICA_CAMERA_LEGISLATURE=19
VERAPOLITICA_CAMERA_REQUEST_TIMEOUT_SECONDS=30
VERAPOLITICA_GOVERNO_INDEX_URL=https://www.governo.it/it/ministri-e-sottosegretari
VERAPOLITICA_GOVERNO_REQUEST_TIMEOUT_SECONDS=30
VERAPOLITICA_ISTAT_MUNICIPALITIES_XLSX_URL=https://www.istat.it/storage/codici-unita-amministrative/Elenco-comuni-italiani.xlsx
VERAPOLITICA_DAIT_CURRENT_MAYORS_CSV_URL=https://dait.interno.gov.it/documenti/sindaciincarica.csv
VERAPOLITICA_TERRITORIAL_REQUEST_TIMEOUT_SECONDS=60

# OPTIONAL MONITORING
# Sentry/error tracking is not bundled. If you add it operationally, keep it
# disabled unless a DSN is set, and do not enrich events with PII or secrets.
# VERAPOLITICA_SENTRY_DSN=
