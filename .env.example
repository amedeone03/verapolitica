VERAPOLITICA_DATABASE_URL=sqlite:///./data/verapolitica.db
VERAPOLITICA_RAW_STORAGE_PATH=./data/raw
VERAPOLITICA_SENATO_SPARQL_ENDPOINT=https://dati.senato.it/sparql
VERAPOLITICA_SENATO_LEGISLATURE=19
VERAPOLITICA_SENATO_REQUEST_TIMEOUT_SECONDS=30
VERAPOLITICA_SENATO_PROPOSAL_RECORD_LIMIT=100
VERAPOLITICA_CAMERA_SPARQL_ENDPOINT=https://dati.camera.it/sparql
VERAPOLITICA_CAMERA_LEGISLATURE=19
VERAPOLITICA_CAMERA_REQUEST_TIMEOUT_SECONDS=30
VERAPOLITICA_GOVERNO_INDEX_URL=https://www.governo.it/it/ministri-e-sottosegretari
VERAPOLITICA_GOVERNO_REQUEST_TIMEOUT_SECONDS=30
VERAPOLITICA_ISTAT_MUNICIPALITIES_XLSX_URL=https://www.istat.it/storage/codici-unita-amministrative/Elenco-comuni-italiani.xlsx
VERAPOLITICA_DAIT_CURRENT_MAYORS_CSV_URL=https://dait.interno.gov.it/documenti/sindaciincarica.csv
VERAPOLITICA_TERRITORIAL_REQUEST_TIMEOUT_SECONDS=60

# Required to access /admin/* routes.
# Set a long random secret locally. Never commit the real secret.
VERAPOLITICA_ADMIN_API_KEY=

# Identity recorded for review actions performed through the Admin API.
VERAPOLITICA_ADMIN_REVIEWER_IDENTITY=local-editor

# Optional AI extraction. Blank values disable live provider calls.
VERAPOLITICA_LLM_PROVIDER=
VERAPOLITICA_LLM_MODEL=
VERAPOLITICA_LLM_API_KEY=
VERAPOLITICA_LLM_TIMEOUT_SECONDS=60
VERAPOLITICA_LLM_MAX_RETRIES=1
VERAPOLITICA_AI_MAX_DOCUMENT_BYTES=10000000
VERAPOLITICA_AI_MAX_CHUNK_CHARS=4000
VERAPOLITICA_AI_MAX_DOCUMENT_CHUNKS=200
VERAPOLITICA_AI_MAX_CHUNKS_PER_RUN=40
VERAPOLITICA_AI_MAX_EVIDENCE_EXCERPT_CHARS=600
VERAPOLITICA_AI_EVAL_MIN_PRECISION=0.90
VERAPOLITICA_AI_EVAL_MIN_EVIDENCE_ACCURACY=0.95
VERAPOLITICA_AI_EVAL_MAX_HALLUCINATION_RATE=0.05
